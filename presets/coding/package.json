{
  "name": "@yandy/pi-preset-coding",
  "version": "0.1.0",
  "private": true,
  "description": "Pi 组合包：coding 类项目",
  "files": [
    "package.json",
    "package-lock.json",
    "CHANGELOG.md",
    "README.md",
    "skills/",
    "prompts/",
    "themes/"
  ],
  "dependencies": {
    "superpowers": "git+https://github.com/obra/superpowers.git#v7.0.2"
  },
  "pi": {
    "extensions": [
      "node_modules/*/extensions",
      "node_modules/@*/*/extensions",
      "node_modules/superpowers/.pi/extensions"
    ],
    "skills": [
      "./skills",
      "node_modules/*/skills",
      "node_modules/@*/*/skills"
    ],
    "prompts": [
      "./prompts",
      "node_modules/*/prompts",
      "node_modules/@*/*/prompts"
    ],
    "themes": [
      "./themes",
      "node_modules/*/themes",
      "node_modules/@*/*/themes"
    ],
    "changelogPath": "./CHANGELOG.md"
  }
}
